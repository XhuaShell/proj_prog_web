<div class="layout-panel">
        <div class="sidebar">
        <h4><%= panelInfo.title %></h4>
        <h5><%= user.username %></h5>

        <hr class="linea-bonita">

        <nav>
            <% for (let section of panelInfo.sections) { %>

                <span><%= section.title %></span>

                <% for (let button of section.buttons ) { %>
                    <a href="<%= button.link %>" class="menu-item">
                        <%= button.name %>
                    </a>
                <% } %>

                <hr class="linea-bonita linea-bonita-secundaria">

            <% } %>
        </nav>
    </div>

    <!-- CONTENIDO -->
<div class="contenido-panel">